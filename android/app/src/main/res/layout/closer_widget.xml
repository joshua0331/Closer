<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/closer_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="17dp"
    android:paddingTop="14dp"
    android:paddingEnd="17dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/closer_widget_heart_background"
            android:gravity="center"
            android:text="♥"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:fontFamily="sans-serif-rounded"
            android:letterSpacing="0.12"
            android:text="CLOSER"
            android:textColor="#FF9B5948"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="" />

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/closer_widget_badge_neutral"
            android:fontFamily="sans-serif-rounded"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:text="READY"
            android:textColor="#FF8C5948"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_names"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-rounded"
        android:maxLines="1"
        android:text="You  ♥  Partner"
        android:textColor="#FF49352D"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_distance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-rounded"
        android:maxLines="1"
        android:text="1,000 km"
        android:textColor="#FFB85842"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/closer_widget_status_background"
        android:ellipsize="end"
        android:fontFamily="sans-serif-rounded"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="Last shared · tap to open your map"
        android:textColor="#FF806D65"
        android:textSize="10sp" />
</LinearLayout>
